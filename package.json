{
  "name": "@horychen/mdterminal",
  "version": "0.2.0",
  "description": "Read Markdown in the terminal, with images and LaTeX math actually rendered.",
  "type": "module",
  "bin": {
    "mdterm": "dist/cli.js",
    "mdterminal": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike": "tsx src/spike.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "mathjax-full": "^3.2.1",
    "mermaid": "^11.16.1",
    "puppeteer-core": "^25.5.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horychen/mdTerminal.git"
  },
  "keywords": [
    "markdown",
    "terminal",
    "latex",
    "math",
    "kitty-graphics",
    "ghostty",
    "cli"
  ]
